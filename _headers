# Cloudflare Pages security + cache headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Intentionally NO Content-Security-Policy yet — Clerk, Google Fonts,
# Supabase, and Socket.IO need a carefully tested allowlist.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Fingerprinted / versioned static assets — long cache is safe
/css/*
  Cache-Control: public, max-age=31536000, immutable

/css/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/logo-assets/*
  Cache-Control: public, max-age=31536000, immutable

/lang/*
  Cache-Control: public, max-age=86400

/*.js
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=86400

# HTML shell — always revalidate so deploys show up quickly
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
