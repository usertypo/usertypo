# Copy to `.env` for local development. Never commit `.env`.
# Names only — replace every value with your own project credentials.

# ── Public (browser-safe; optional overrides for local `npm run dev`) ──
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_FRONTEND_API=your-app.clerk.accounts.dev
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_ANON_KEY=replace_me   # legacy fallback only
# Override the Cloudflare worker URLs from js/config/public.js:
# MULTIPLAYER_SERVER_URL=http://127.0.0.1:8787
# LEADERBOARDS_WORKER_URL=http://127.0.0.1:8788

# ── Server-only secrets (never put these in js/config/public.js) ──
# Worker secrets are set with wrangler, not this file:
#   npx wrangler secret put CLERK_SECRET_KEY --env dev
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --env dev
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ── Local Express (static SPA + /api/geo) ──
ALLOWED_ORIGINS=http://localhost:3000

# ── Contact form ──
CONTACT_TO_EMAIL=contactus@usertypo.com
# Optional providers (recommended over FormSubmit once configured):
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=usertypo_ <onboarding@resend.dev>
# Shown in FormSubmit emails (defaults to PUBLIC_SITE_URL / https://usertypo.com):
# CONTACT_FORMSUBMIT_ORIGIN=https://usertypo.com

