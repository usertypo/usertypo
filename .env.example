# Public frontend configuration
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_FRONTEND_API=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_ANON_KEY=replace_me
MULTIPLAYER_SERVER_URL=

# Server-only secrets (never expose these in js/config/public.js)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Multiplayer server
ALLOWED_ORIGINS=http://localhost:3000
MAX_BURST_WPM=280
MAX_SUSTAINED_WPM=220

# Contact form destination (defaults to contactusertypo@gmail.com)
CONTACT_TO_EMAIL=contactusertypo@gmail.com

# Optional email providers (recommended over FormSubmit once configured):
# 1) Web3Forms — get a free access key at https://web3forms.com (emailed to you)
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 2) Resend — https://resend.com API key (from: onboarding@resend.dev only works to your signup email)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=usertypo_ <onboarding@resend.dev>
#
# Optional: force FormSubmit referring origin (defaults to https://usertypo.onrender.com)
# CONTACT_FORMSUBMIT_ORIGIN=https://usertypo.onrender.com

# Render keep-awake: set this to the deployed https:// service URL
SELF_PING_ENABLED=true
SELF_PING_URL=
# Public (browser-safe) — optional overrides for local/dev injection
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_FRONTEND_API=your-app.clerk.accounts.dev

# Server-only — never expose these in frontend code
# CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Supabase (public client values)
SUPABASE_URL=https://skebosepedaxnvcaizka.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SUPABASE_ANON_KEY=eyJhbGciOi...   # legacy fallback only

# Server-only Supabase — never put in frontend
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Upstash Redis — NEVER put these in browser/public config.
# Add them as Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets).
# See supabase/LEADERBOARDS_REDIS.md for exact setup steps.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx
