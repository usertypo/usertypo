{
  "rewrites": [
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/signin", "destination": "/index.html" },
    { "source": "/friends", "destination": "/index.html" },
    { "source": "/room", "destination": "/index.html" },
    { "source": "/dual", "destination": "/index.html" },
    { "source": "/leaderboards", "destination": "/index.html" },
    { "source": "/userstats", "destination": "/index.html" },
    {
      "source": "/((?!pages/|css/|js/|logo-assets/|sounds/|lang/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Usertypo-Fragment", "value": "1" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
